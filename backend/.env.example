# ---- Database ----
# Local Postgres (matches docker-compose service "db" when run from your host)
DATABASE_URL=postgresql+psycopg2://medistruct_user:CHANGE_ME@localhost:5432/medistruct
POSTGRES_USER=medistruct_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medistruct

# ---- Auth ----
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- NLP models ----
# Any Hugging Face token-classification model trained on biomedical/clinical text.
NER_MODEL_NAME=d4data/biomedical-ner-all
NER_MODEL_REVISION=
NER_AGGREGATION_STRATEGY=max
NER_MIN_CONFIDENCE=0.5
NER_CHUNK_CHARS=1000
# Optional JSON file {"Model_Label": "Our Type"} replacing the built-in label mapping
NER_LABEL_MAP_PATH=
# "rule_based" = built-in relation extractor; optional JSON rules file overrides its schema
RELATION_MODEL_NAME=rule_based
RELATION_SCHEMA_PATH=
RELATION_MIN_CONFIDENCE=0.35
# true = load the NER model when the server starts (slower start, faster first request)
PRELOAD_MODELS=false

# ---- Files ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Dev convenience only. Use Alembic migrations normally.
AUTO_CREATE_TABLES=false
